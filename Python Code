# Creating a factorial function

def factorial(num):
    # Your code goes here.
    if type(num) == str:
        return None
    elif num == 0:
        return 1
    elif num < 0:
        return None
    elif type(num) == float:
        return None
    else:
        myList = []
        num = int(num)
        while num > 0:
            myList.append(num)
            num = num - 1
        total = 1
        for i in myList:
            total = total * i
        return total
